# Copy to .env.local for development. Set the real values in Vercel env vars.
# Never commit .env.local. The FUB key must never reach client code. CLAUDE.md §9.

# Follow Up Boss.
#
# FUB_API_KEY is a personal key generated from Jasmine's own user (FUB → her
# avatar → My Settings → API). A personal key acts as that user, which is what
# we want; it also dies with the user, so if her account is ever removed from
# the brokerage this integration stops rather than silently posting as someone
# else.
FUB_API_KEY=

# Who the lead is assigned to. SET ONE OF THESE.
#
# The key lives inside the brokerage's FUB account, whose Lead Flow rules are
# configured elsewhere and can route an incoming lead — including round-robin.
# A lead this site produced should land on her, so assignment is stated rather
# than left to a default. See the header of lib/fub.ts.
#
# Prefer the numeric id: a display name changes, an id does not. Get it from
# GET https://api.followupboss.com/v1/identity, which also confirms which
# account and user the key authenticates as.
#
# Note the API host is api.followupboss.com for every account. The team logs in
# at mattstone.followupboss.com and mints keys at /2/api on that host, but that
# is the web app — see the comment on FUB_ENDPOINT in lib/fub.ts.
FUB_ASSIGNED_USER_ID=
FUB_ASSIGNED_TO=

# Registered-system identification. Optional, both or neither.
#
# The API key says who the request is for; X-System says what made it. Register
# at https://apps.followupboss.com/system-registration. Raises the rate limit
# from 125 to 250 requests per 10s (irrelevant here) and makes the integration
# identifiable in the account as this website rather than an anonymous caller —
# which is the actual reason to bother.
FUB_SYSTEM=
FUB_SYSTEM_KEY=

# Resend — transactional email fallback so a lead is never lost
RESEND_API_KEY=
LEAD_FROM_EMAIL="Jasmine Garcia Website <leads@jasminegarcia.com>"
LEAD_NOTIFICATION_EMAIL=

# GA4 — public by design (ships in client JS), but keep it in env rather than
# hardcoded so staging/other checkouts don't report into the production
# property. Only fires when NODE_ENV=production (components/google-analytics.tsx).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DHYEFNYELD
